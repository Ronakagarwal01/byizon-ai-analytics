# Existing AI configuration
VITE_HF_API_KEY=
VITE_HF_MODEL=
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional Google Stitch design generation (server-side only; never use VITE_ prefix)
STITCH_API_KEY=
STITCH_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=

# ElevenLabs voice assistant
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# OAuth callback configuration
OAUTH_CALLBACK_BASE=http://localhost:8000
FRONTEND_URL=http://127.0.0.1:5173/connections
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Set this to a persistent mounted directory in production (for example /var/data).
BYIZON_DATA_DIR=
# Optional 32-byte URL-safe base64 key. If empty, a local private key is generated.
BYIZON_CONNECTOR_ENCRYPTION_KEY=
# Signs the anonymous browser workspace cookie used to isolate each user's OAuth connections.
# Set a long random value in production. If empty locally, a private key is generated on disk.
BYIZON_SESSION_SECRET=

# Microsoft Entra ID application
MICROSOFT_365_CLIENT_ID=
MICROSOFT_365_CLIENT_SECRET=

# Google Cloud OAuth web application
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_SCOPES=openid email profile https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/documents

# Slack app OAuth (read/analyze channels) and incoming webhook (send notifications)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
SLACK_SCOPES=channels:read channels:history channels:join groups:read groups:history files:read chat:write
SLACK_NOTIFY_ANALYSIS=false

# Salesforce external client / connected app
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HubSpot public app
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read

# Atlassian OAuth 2.0 (3LO) application for Jira Cloud
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_SCOPES=offline_access read:jira-work read:jira-user

# Organization-specific OAuth providers
GLEAN_CLIENT_ID=
GLEAN_CLIENT_SECRET=
GLEAN_AUTHORIZE_URL=
GLEAN_TOKEN_URL=
GLEAN_SCOPES=

ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=
ZAPIER_AUTHORIZE_URL=
ZAPIER_TOKEN_URL=
ZAPIER_SCOPES=

WORKATO_CLIENT_ID=
WORKATO_CLIENT_SECRET=
WORKATO_AUTHORIZE_URL=
WORKATO_TOKEN_URL=
WORKATO_SCOPES=
